.admin-workspace .admin-sidebar{overflow-y:auto;scrollbar-width:thin}
.admin-workspace .admin-sidebar nav{display:grid;gap:4px;overflow:visible;padding:14px 0 24px}
.admin-workspace .admin-sidebar nav>a,.admin-workspace .admin-nav-parent{display:flex;align-items:center;gap:10px;width:100%;min-height:44px;padding:10px 12px;border:0;border-radius:8px;background:transparent;color:#244838;font:600 14px/1.35 Arial,sans-serif;text-align:left;text-decoration:none}
.admin-workspace .admin-sidebar nav>a>span,.admin-workspace .admin-nav-parent>span:first-child{display:grid;place-items:center;width:20px;flex:0 0 20px;font-size:18px}
.admin-workspace .admin-nav-parent:hover,.admin-workspace .admin-nav-group.active>.admin-nav-parent{background:#e9f2e4;color:#17483f}
.admin-workspace .admin-nav-chevron{margin-left:auto;transition:transform .15s}
.admin-workspace .admin-nav-parent[aria-expanded=true] .admin-nav-chevron{transform:rotate(180deg)}
.admin-workspace .admin-subnav{display:grid;margin:4px 0 8px 22px;padding-left:8px;border-left:2px solid #dfe8db}
.admin-workspace .admin-subnav[hidden]{display:none!important}
.admin-workspace .admin-subnav a{font-size:13px;min-width:0;min-height:38px;padding:8px 12px}
.admin-workspace .admin-topbar{position:sticky;top:0;z-index:50;min-height:72px;height:auto;padding:12px 24px}
.admin-workspace .admin-topbar form{box-shadow:none;background:transparent}
.admin-workspace .admin-menu-toggle,.admin-nav-backdrop{display:none}
.admin-workspace .admin-page{max-width:1600px;margin:auto;padding:24px}
.admin-workspace .admin-title>div{flex-wrap:wrap}
.admin-workspace .admin-panel,.admin-workspace .admin-data-card,.admin-workspace .revenue-grid>*{min-width:0}
.admin-workspace .admin-data-card{overflow-x:auto}
.admin-workspace .admin-table-scroll,.admin-workspace .order-table-wrap{max-width:100%;overflow-x:auto}
.admin-workspace .revenue-filter-search{grid-column:auto}
.admin-workspace .revenue-filters,.admin-workspace .revenue-cards{grid-template-columns:repeat(auto-fit,minmax(min(160px,100%),1fr))}
.admin-workspace .revenue-pie{grid-template-columns:minmax(0,1fr)}
.admin-workspace .revenue-pie:before{margin:auto}
.admin-workspace .section-actions,.admin-workspace .fund-pagination{flex-wrap:wrap}
.admin-workspace .section-actions span{flex-wrap:wrap}
.admin-workspace .admin-edit-grid :is(input,select,textarea),.admin-workspace .revenue-filters :is(input,select){min-width:0;width:100%}
.admin-workspace .admin-edit-grid input[type=checkbox]{width:auto}
.admin-workspace .admin-actions details[open]>.admin-edit-grid{padding-top:48px}
.admin-edit-close{position:absolute;right:14px;top:10px;background:#eef3eb!important;color:#17483f!important}
.admin-workspace .admin-volume-chart{gap:3px;padding-left:0;padding-right:0}
.admin-workspace .admin-volume-chart>div{min-width:0}
body.admin-portal:has(.admin-workspace) .portal-back-dashboard{display:none}
@media(min-width:721px) and (max-width:1050px){.admin-workspace .admin-identity{display:none}.admin-workspace .admin-topbar{gap:10px;padding:12px 16px}.admin-workspace .admin-topbar>form:first-of-type{flex:1;width:auto}}
@media(max-width:720px){
 .admin-workspace{display:block}
 .admin-workspace .admin-sidebar{position:fixed;inset:0 auto 0 0;width:min(286px,85vw);height:100dvh;z-index:1100;background:#fff;box-shadow:10px 0 30px #102d1e22;transform:translateX(-105%);visibility:hidden;transition:transform .18s,visibility .18s}
 .admin-workspace.nav-open .admin-sidebar{transform:translateX(0);visibility:visible}
 .admin-workspace .admin-sidebar nav{display:grid;overflow:visible}
 .admin-workspace .admin-sidebar nav a{min-width:0}
 .admin-workspace .admin-brand{height:68px}
 .admin-workspace.nav-open .admin-nav-backdrop:not([hidden]){display:block;position:fixed;inset:0;z-index:1050;background:#102d1e66;border:0;padding:0}
 .admin-workspace .admin-menu-toggle{display:inline-grid;place-items:center;min-width:42px;min-height:42px;border:1px solid #d7e1d3;border-radius:10px;background:#fff;color:#17483f;font-size:22px}
 .admin-workspace .admin-topbar{display:grid;grid-template-columns:42px 1fr auto;gap:10px;padding:12px 14px}
 .admin-workspace .admin-topbar>form:first-of-type{grid-row:2;grid-column:1/-1;order:0;width:100%;margin:0}
 .admin-workspace .admin-topbar>form:nth-of-type(2){grid-column:3;grid-row:1}
 .admin-workspace .admin-system{grid-column:2;grid-row:1;justify-self:start;margin:0;font-size:12px;padding:8px}
 .admin-workspace .admin-identity{display:none}
 .admin-workspace .admin-page{padding:20px 14px}
 .admin-workspace .admin-title{gap:8px}
 .admin-workspace .admin-title h1{font-size:23px}
 .admin-workspace .admin-kpis{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
 .admin-workspace .admin-kpis a{padding:14px;min-height:122px}
 .admin-workspace .admin-kpis strong{font-size:26px}
 .admin-workspace .admin-overview-grid,.admin-workspace .admin-bottom-grid,.admin-workspace .revenue-grid,.admin-workspace .revenue-filters{grid-template-columns:minmax(0,1fr)}
 .admin-workspace .admin-live-map .dashvanti-google-map{height:300px}
 .admin-workspace .admin-rank-list a{grid-template-columns:24px minmax(0,1fr) auto;font-size:12px}
 .admin-workspace .admin-form-panels,.admin-workspace .admin-settings-grid,.admin-workspace .admin-edit-grid{grid-template-columns:minmax(0,1fr)}
 .admin-workspace .admin-edit-grid .admin-wide{grid-column:auto}
 .admin-workspace .admin-ticket>div{flex-wrap:wrap}
 .admin-workspace .admin-ticket p{overflow-wrap:anywhere}
 .admin-workspace .fund-pagination{justify-content:flex-start;gap:10px}
 body.admin-nav-open{overflow:hidden}
}
@media(prefers-reduced-motion:reduce){.admin-workspace .admin-sidebar{transition:none}}
