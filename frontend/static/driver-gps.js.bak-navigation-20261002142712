(() => {
 let watch=null,timer=null,position,busy=false,lastSent=0,lastSaved=null,navigating=false,lastGeocode=0;
 const report=status=>window.dispatchEvent(new CustomEvent('dashvanti:gps-status',{detail:{status}}));

 function moved(value){
  if(!lastSaved)return true;
  const radians=Math.PI/180;
  const a=value.latitude*radians,b=lastSaved.latitude*radians;
  const dlat=a-b,dlng=(value.longitude-lastSaved.longitude)*radians;
  const h=Math.sin(dlat/2)**2+Math.cos(a)*Math.cos(b)*Math.sin(dlng/2)**2;
  const distance=6371000*2*Math.asin(Math.min(1,Math.sqrt(h)));
  return distance>=0.3048;
 }

 function stop(){if(watch!==null)navigator.geolocation?.clearWatch(watch);watch=null;clearInterval(timer);timer=null;position=null;}

 async function save(overrideCoords){
  const sample = overrideCoords || position?.coords;
  if(!sample || busy) return;
  if(!overrideCoords && Date.now() - lastSent < 900) return;
  if(!overrideCoords && !navigating && !moved(sample)) return;
  if(!overrideCoords && Date.now() - position.timestamp > 10000) return;
  busy=true; lastSent=Date.now();
  const tracking=document.querySelector('[data-live-tracking]:not([hidden])');
  const orderId=Number(tracking?.dataset.orderId)||undefined;
  const csrf=document.querySelector('[name=csrfmiddlewaretoken]')?.value||'';
  const body={
    latitude: sample.latitude,
    longitude: sample.longitude,
    heading: sample.heading ?? null,
    speed: sample.speed || 0,
    order_id: orderId
  };
  try{
   const response=await fetch('/driver/location/update',{
     method:'POST',
     body:JSON.stringify(body),
     credentials:'same-origin',
     headers:{'Content-Type':'application/json','X-CSRFToken':csrf},
     signal:AbortSignal.timeout(12000)
   });
   if(!response.ok){
     report('GPS save retry…');
     return;
   }
   lastSaved={latitude:sample.latitude,longitude:sample.longitude};
   report('live');
   updateGpsIndicator(true);
  }catch(_){
   report('GPS connection offline');
   updateGpsIndicator(false);
  }finally{
   busy=false;
  }
 }

 function updateGpsIndicator(active) {
  const badge = document.getElementById('driver-location-badge');
  if(!badge) return;
  if(active) {
    badge.style.background = '#dff5e8';
    badge.style.color = '#087238';
  } else {
    badge.style.background = '#fff1ce';
    badge.style.color = '#8a5a00';
  }
 }

 function reverseGeocodeBadge(lat, lng) {
  const badge = document.getElementById('driver-location-badge');
  const input = document.getElementById('driver-address-input');
  if(!badge && !input) return;

  const updateText = (addressText) => {
    if(badge) badge.textContent = '🟢 LIVE GPS · ' + addressText;
    if(input && input.dataset.manualOverride !== 'true' && document.activeElement!==input) {
      input.value = addressText;
      input.dataset.autoFilled = 'true';
    }
  };

  if(window.google?.maps?.Geocoder) {
    new google.maps.Geocoder().geocode({location:{lat, lng}}, (results, status) => {
      if(status === 'OK' && results?.[0]) {
        updateText(results[0].formatted_address);
      } else {
        updateText(lat.toFixed(5) + ', ' + lng.toFixed(5));
      }
    });
  } else {
    updateText(lat.toFixed(5) + ', ' + lng.toFixed(5));
  }
 }

 function received(value){
  position=value;
  const detail={
    latitude: value.coords.latitude,
    longitude: value.coords.longitude,
    heading: value.coords.heading ?? null,
    speed: value.coords.speed || 0,
    timestamp: value.timestamp
  };
  window.dashvantiDriverPosition=detail;
  window.dispatchEvent(new CustomEvent('dashvanti:driver-position',{detail}));
  void save();
  if(Date.now()-lastGeocode>30000){lastGeocode=Date.now();reverseGeocodeBadge(value.coords.latitude, value.coords.longitude);}
 }

 function failed(error){
  updateGpsIndicator(false);
  const badge = document.getElementById('driver-location-badge');
  if(error.code===1){
    stop();
    report('Location permission denied.');
    if(badge && !window.dashvantiDriverPosition) badge.textContent = '⚠️ Location permission denied. Please allow location or search address above.';
  } else {
    report('Waiting for live GPS signal…');
    if(badge && !window.dashvantiDriverPosition) badge.textContent = '📡 Acquiring live GPS location…';
  }
 }

 function start(){
  if(!document.body.classList.contains('driver-portal'))return;
  if(!navigator.geolocation) {
    const badge = document.getElementById('driver-location-badge');
    if(badge && !window.dashvantiDriverPosition) badge.textContent = '⚠️ Browser Geolocation unavailable. Please search address above.';
    return;
  }
  if(watch!==null) return;

  const optionsHigh = {enableHighAccuracy: true, maximumAge: 0, timeout: 8000};
  const optionsLow = {enableHighAccuracy: false, maximumAge: 10000, timeout: 15000};

  const acquireLocation = () => {
    navigator.geolocation.getCurrentPosition(
      received,
      (err) => {
        navigator.geolocation.getCurrentPosition(received, failed, optionsLow);
      },
      optionsHigh
    );
  };

  acquireLocation();
  watch = navigator.geolocation.watchPosition(received, (err) => {
    if(err.code === 3 || err.code === 2) {
      navigator.geolocation.getCurrentPosition(received, failed, optionsLow);
    } else {
      failed(err);
    }
  }, optionsHigh);

  timer = setInterval(() => {
    if(navigating) navigator.geolocation.getCurrentPosition(received, failed, optionsHigh);
    else void save();
  }, 1000);
 }

 function initPlacesAutocomplete() {
  const input = document.getElementById('driver-address-input');
  const badge = document.getElementById('driver-location-badge');
  const statusDiv = document.getElementById('driver-address-status');
  if(!input || input.dataset.autocompleteInit) return;

  if(window.google?.maps?.places?.Autocomplete) {
    input.dataset.autocompleteInit = 'true';
    const autocomplete = new google.maps.places.Autocomplete(input, {
      types: ['geocode', 'establishment']
    });

    autocomplete.addListener('place_changed', () => {
      const place = autocomplete.getPlace();
      if(place && place.geometry && place.geometry.location) {
        const lat = place.geometry.location.lat();
        const lng = place.geometry.location.lng();
        const formatted = place.formatted_address || place.name;

        input.value = formatted;
        delete input.dataset.autoFilled;
        const detail = {latitude: lat, longitude: lng, heading: 0, speed: 0, timestamp: Date.now()};
        window.dashvantiDriverPosition = detail;
        window.dispatchEvent(new CustomEvent('dashvanti:driver-position', {detail}));
        void save({latitude: lat, longitude: lng, heading: 0, speed: 0});

        if(badge) badge.textContent = '📍 Current Address: ' + formatted;
        if(statusDiv) statusDiv.textContent = '✅ Location set and pinned on map: ' + formatted;
      }
    });
  } else {
    setTimeout(initPlacesAutocomplete, 500);
  }
 }

 async function setupAddressUI() {
  const btnSet = document.getElementById('btn-set-driver-address');
  const btnGps = document.getElementById('btn-use-live-gps');
  const addressInput = document.getElementById('driver-address-input');
  const statusDiv = document.getElementById('driver-address-status');
  const badge = document.getElementById('driver-location-badge');

  initPlacesAutocomplete();

  if(btnGps) {
    btnGps.addEventListener('click', () => {
      if(!navigator.geolocation) {
        if(statusDiv) statusDiv.textContent = 'Geolocation is not supported by your browser.';
        return;
      }
      if(addressInput){addressInput.dataset.manualOverride = 'false'; addressInput.dataset.autoFilled = 'true';}
      if(statusDiv) statusDiv.textContent = 'Detecting current live GPS location…';
      navigator.geolocation.getCurrentPosition((pos) => {
        if(addressInput){addressInput.dataset.manualOverride = 'false'; addressInput.dataset.autoFilled = 'true';}
        received(pos);
        if(statusDiv) statusDiv.textContent = '✅ Updated to live GPS location!';
      }, (err) => {
        navigator.geolocation.getCurrentPosition(received, (err2) => {
          if(statusDiv) statusDiv.textContent = 'Unable to fetch GPS: ' + err2.message;
        }, {enableHighAccuracy:false, timeout:15000});
      }, {enableHighAccuracy:true, timeout:8000});
    });
  }

  if(btnSet && addressInput) {
    const handleSetAddress = () => {
      const query = addressInput.value.trim();
      if(!query) {
        if(statusDiv) statusDiv.textContent = 'Please enter an address first.';
        return;
      }
      if(statusDiv) statusDiv.textContent = 'Searching location…';
      if(window.google?.maps?.Geocoder) {
        new google.maps.Geocoder().geocode({address: query}, (results, status) => {
          if(status === 'OK' && results?.[0]) {
            const loc = results[0].geometry.location;
            const lat = loc.lat();
            const lng = loc.lng();
            const formatted = results[0].formatted_address;

            addressInput.value = formatted;
            delete addressInput.dataset.autoFilled;
            const detail = {latitude: lat, longitude: lng, heading: 0, speed: 0, timestamp: Date.now()};
            window.dashvantiDriverPosition = detail;
            window.dispatchEvent(new CustomEvent('dashvanti:driver-position', {detail}));
            void save({latitude: lat, longitude: lng, heading: 0, speed: 0});

            if(badge) badge.textContent = '📍 Current Address: ' + formatted;
            if(statusDiv) statusDiv.textContent = '✅ Location set: ' + formatted;
          } else {
            if(statusDiv) statusDiv.textContent = 'Could not locate address. Choose from automatic suggestions.';
          }
        });
      }
    };

    btnSet.addEventListener('click', handleSetAddress);
    addressInput.addEventListener('keydown', (e) => {
      if(e.key === 'Enter') {
        e.preventDefault();
        handleSetAddress();
      }
    });
  }
 }

 async function loadPresenceLocation() {
  try {
    const res = await fetch('/driver/presence', {credentials: 'same-origin'});
    if(res.ok) {
      const data = await res.json();
      if(data.location && data.location.latitude && data.location.longitude) {
        const detail = {
          latitude: data.location.latitude,
          longitude: data.location.longitude,
          heading: data.location.heading || 0,
          speed: 0,
          timestamp: Date.now()
        };
        window.dashvantiDriverPosition = detail;
        window.dispatchEvent(new CustomEvent('dashvanti:driver-position', {detail}));
        reverseGeocodeBadge(detail.latitude, detail.longitude);
      }
    }
  } catch(_) {}
 }

 window.addEventListener('dashvanti:navigation-start',()=>{navigating=true;start();});
 window.addEventListener('dashvanti:tracking',event=>{navigating=['ON_THE_WAY_TO_RESTAURANT','PICKED_UP','ON_THE_WAY_TO_CUSTOMER','ARRIVED_AT_CUSTOMER'].includes(event.detail?.driver_status);});
 window.addEventListener('dashvanti:portal-live',event=>{navigating=event.detail.navigation_active;});
 async function initialize(){
  if(!document.body.classList.contains('driver-portal')||!document.querySelector('.portal-logout-button,[data-order-alerts]'))return;
  setupAddressUI();
  await loadPresenceLocation();
  start();
 }

 window.addEventListener('pageshow', (event) => { if(event.persisted) initialize(); });
 document.addEventListener('touchstart', () => { if(!position && navigator.geolocation) start(); }, {once:true});
 if(document.readyState === 'loading') {
   document.addEventListener('DOMContentLoaded', initialize);
 } else {
   initialize();
 }
})();

(() => {
 const input=document.getElementById('driver-address-input');
 const status=document.getElementById('driver-address-status');
 const badge=document.getElementById('driver-location-badge');
 if(!input || input.dataset.keywordSuggestInit)return;
 input.dataset.keywordSuggestInit='true';
 let timer=null,sessionToken=null,lastPredictions=[];
 const list=document.createElement('div');
 list.id='driver-address-suggestions';
 list.setAttribute('role','listbox');
 list.hidden=true;
 list.style.cssText='position:absolute;z-index:120;background:#fff;border:1px solid #b9dcd8;border-radius:10px;box-shadow:0 14px 28px #0a3f4426;max-height:260px;overflow:auto;min-width:260px;';
 document.body.appendChild(list);
 const csrf=()=>document.querySelector('[name=csrfmiddlewaretoken]')?.value||'';
 const placeList=()=>{
  const rect=input.getBoundingClientRect();
  list.style.left=(rect.left+window.scrollX)+'px';
  list.style.top=(rect.bottom+window.scrollY+4)+'px';
  list.style.width=rect.width+'px';
 };
 const dispatchPosition=(lat,lng,heading=0)=>{
  const detail={latitude:lat,longitude:lng,heading,speed:0,timestamp:Date.now()};
  window.dashvantiDriverPosition=detail;
  window.dispatchEvent(new CustomEvent('dashvanti:driver-position',{detail}));
 };
 const savePosition=async(lat,lng,heading=0)=>{
  dispatchPosition(lat,lng,heading);
  try{
   await fetch('/driver/location/update',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','X-CSRFToken':csrf()},body:JSON.stringify({latitude:lat,longitude:lng,heading,speed:0})});
  }catch(_){}
 };
 const setAddress=(label,lat,lng,source='address', persist=true)=>{
  input.value=label;
  input.dataset.manualOverride=source==='manual'?'true':'false';
  input.dataset.autoFilled=source==='gps'?'true':'false';
  list.hidden=true;
  if(badge)badge.textContent=(source==='gps'?'🟢 LIVE GPS · ':'📍 Current Address: ')+label;
  if(status)status.textContent=(source==='gps'?'Live GPS address updated: ':'Location set: ')+label;
  if(persist)savePosition(lat,lng);
 };
 const geocodeAddress=(query)=>new Promise((resolve,reject)=>{
  if(!window.google?.maps?.Geocoder){reject(new Error('Google Maps is still loading.'));return;}
  new google.maps.Geocoder().geocode({address:query},(results,geoStatus)=>{
   if(geoStatus==='OK'&&results?.[0])resolve(results[0]);
   else reject(new Error('No matching address found.'));
  });
 });
 const resolvePrediction=(prediction)=>{
  if(!prediction)return;
  if(status)status.textContent='Setting address…';
  const serviceAvailable=window.google?.maps?.places?.PlacesService && prediction.place_id;
  if(serviceAvailable){
   const service=new google.maps.places.PlacesService(document.createElement('div'));
   service.getDetails({placeId:prediction.place_id,fields:['formatted_address','geometry','name']},(place,placeStatus)=>{
    if(placeStatus==='OK'&&place?.geometry?.location){
     setAddress(place.formatted_address||place.name||prediction.description,place.geometry.location.lat(),place.geometry.location.lng(),'manual');
    }else geocodeAddress(prediction.description).then(row=>setAddress(row.formatted_address,row.geometry.location.lat(),row.geometry.location.lng(),'manual')).catch(err=>{if(status)status.textContent=err.message;});
   });
  }else{
   geocodeAddress(prediction.description).then(row=>setAddress(row.formatted_address,row.geometry.location.lat(),row.geometry.location.lng(),'manual')).catch(err=>{if(status)status.textContent=err.message;});
  }
 };
 const render=(rows)=>{
  lastPredictions=rows||[];
  list.replaceChildren();
  if(!lastPredictions.length){list.hidden=true;return;}
  placeList();
  for(const row of lastPredictions){
   const button=document.createElement('button');
   button.type='button';
   button.textContent=row.description;
   button.style.cssText='display:block;width:100%;padding:11px 12px;border:0;background:#fff;color:#173f30;text-align:left;font-weight:700;cursor:pointer;';
   button.addEventListener('mouseenter',()=>button.style.background='#e8f6f4');
   button.addEventListener('mouseleave',()=>button.style.background='#fff');
   button.addEventListener('mousedown',event=>{event.preventDefault();resolvePrediction(row);});
   list.append(button);
  }
  list.hidden=false;
 };
 const suggest=()=>{
  const query=input.value.trim();
  input.dataset.manualOverride=query?'true':'false';
  if(query.length<3){list.hidden=true;return;}
  if(status)status.textContent='Searching address suggestions…';
  if(window.google?.maps?.places?.AutocompleteService){
   sessionToken=sessionToken||new google.maps.places.AutocompleteSessionToken();
   new google.maps.places.AutocompleteService().getPlacePredictions({input:query,sessionToken,types:['geocode','establishment']},(rows,predictionStatus)=>{
    if(predictionStatus===google.maps.places.PlacesServiceStatus.OK)render(rows);
    else render([]);
   });
  }else if(window.google?.maps?.Geocoder){
   geocodeAddress(query).then(row=>render([{description:row.formatted_address,place_id:row.place_id}])).catch(()=>render([]));
  }else setTimeout(suggest,500);
 };
 input.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(suggest,250);});
 input.addEventListener('focus',()=>{if(lastPredictions.length){placeList();list.hidden=false;}else suggest();});
 input.addEventListener('keydown',event=>{
  if(event.key==='Enter'&&lastPredictions[0]){event.preventDefault();resolvePrediction(lastPredictions[0]);}
  if(event.key==='Escape')list.hidden=true;
 });
 document.addEventListener('click',event=>{if(event.target!==input&&!list.contains(event.target))list.hidden=true;});
 window.addEventListener('resize',placeList);
 window.addEventListener('scroll',placeList,true);
 window.addEventListener('dashvanti:driver-position',event=>{
  const d=event.detail||{};
  if(!Number.isFinite(Number(d.latitude))||!Number.isFinite(Number(d.longitude)))return;
  if(input.dataset.manualOverride==='true'||document.activeElement===input)return;
  if(Date.now()-(input.dataset.lastReverseGeocode||0)<30000)return;
  input.dataset.lastReverseGeocode=Date.now();
  if(!window.google?.maps?.Geocoder)return;
  new google.maps.Geocoder().geocode({location:{lat:Number(d.latitude),lng:Number(d.longitude)}},(results,geoStatus)=>{
   if(geoStatus==='OK'&&results?.[0])setAddress(results[0].formatted_address,Number(d.latitude),Number(d.longitude),'gps',false);
  });
 });
})();
