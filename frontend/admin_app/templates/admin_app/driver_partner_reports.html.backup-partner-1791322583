{% extends 'admin_app/admin_base.html' %}{% load static %}{% block admin_content %}<link rel="stylesheet" href="{% static 'driver-partners.css' %}"><main class="partner-page"><a href="/admin/driver-partners">← Driver partners</a><h1>{{ kind|title }}</h1><a href="?download=1">Download JSON</a>{% for item in items %}<section><dl class="partner-grid">{% for key,value in item.items %}<div><dt>{{ key|title }}</dt><dd>{{ value }}</dd></div>{% endfor %}</dl>{% if kind == 'withdrawals' and item.status == 'REQUESTED' %}<form method="post" data-no-ajax="true">{% csrf_token %}<input type="hidden" name="id" value="{{ item.id }}"><select name="status"><option>PAID</option><option>REJECTED</option></select><input name="reference" required minlength="3" placeholder="Actual bank/UPI confirmation or rejection reason"><button>Record outcome</button></form>{% endif %}{% if kind == 'incidents' %}<form method="post" data-no-ajax="true">{% csrf_token %}<input type="hidden" name="id" value="{{ item.id }}"><select name="status"><option>INVESTIGATING</option><option>RESOLVED</option><option>OPEN</option></select><textarea name="resolution" placeholder="Resolution / follow-up"></textarea><button>Update incident</button></form>{% endif %}</section>{% empty %}<p>No records.</p>{% endfor %}</main>{% endblock %}
