{% extends 'admin_app/admin_base.html' %}
{% block admin_content %}
<div class="admin-title"><div><h1>Orders</h1><span class="admin-live">{{ rows|length }} results</span></div><p>Live order records from the database.</p></div>
<form class="admin-filters" method="get"><label><span>Search</span><input name="q" value="{{ q }}" placeholder="Order, restaurant, customer or driver"></label><label><span>Status</span><select name="status"><option value="">All statuses</option>{% for value in statuses %}<option value="{{ value }}" {% if status == value %}selected{% endif %}>{{ value|title }}</option>{% endfor %}</select></label><button type="submit">Search</button><a href="/admin/orders">Clear</a></form>
<section class="admin-data-card"><div class="admin-table-scroll"><table class="order-data-table" data-order-table><thead><tr><th>Order ID</th><th>Restaurant</th><th>Customer</th><th>Driver</th><th>Mode</th><th>Total</th><th>Status</th></tr></thead><tbody>
{% for row in rows %}<tr data-order-url="/admin/order/{{ row.order.id }}" tabindex="0"><td><a href="/admin/order/{{ row.order.id }}" aria-label="View order {{ row.order.id }} details">#{{ row.order.id }}</a></td><td>{{ row.restaurant.name|default:'Unknown' }}</td><td>{{ row.customer.name|default:'Unknown' }}</td><td>{{ row.driver.name|default:'Unassigned' }}</td><td>{{ row.order.mode|title }}</td><td>${{ row.order.total }}</td><td><span class="admin-status status-{{ row.order.status|lower }}">{{ row.order.status|title }}</span></td></tr>{% empty %}<tr><td colspan="7">No matching orders.</td></tr>{% endfor %}
</tbody></table></div></section>
{% endblock %}
