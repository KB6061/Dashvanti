@router.post('/admin/driver-partners/documents/{document_id}/review')
def review_document(document_id: int, data: DocumentReview, actor=Depends(manager), db=Depends(get_db, scope='function')):
    row = db.get(DriverDocument, document_id)
    if not row: raise HTTPException(404, 'Document not found')
    row.status = data.status; row.notes = data.notes
    service.audit(db, actor, row.driver_id, 'document:'+data.status, f'{row.kind}: {data.notes}')
    service.notice(db, row.driver_id, 'DOCUMENT_'+data.status, row.kind.replace('_', ' ').title() + ': ' + data.status.lower())
    return {'id': row.id, 'status': row.status}


@router.put('/admin/driver-partners/{driver_id}/insurance')
def insurance(driver_id: int, data: InsuranceInput, actor=Depends(admin), db=Depends(get_db, scope='function')):
    service.partner(db, driver_id)
    if data.active and data.expires_on <= date.today(): raise HTTPException(422, 'Policy must not be expired')
    row = db.get(DriverInsurance, driver_id)
    if not row: row = DriverInsurance(driver_id=driver_id); db.add(row)
    for key, value in data.model_dump().items(): setattr(row, key, value)
    service.audit(db, actor, driver_id, 'insurance-updated', data.policy_number)
    return {'saved': True}


@router.post('/admin/driver-partners/{driver_id}/insurance-claims')
def claim(driver_id: int, data: ClaimInput, actor=Depends(admin), db=Depends(get_db, scope='function')):
    incident = db.get(DriverIncident, data.incident_id)
    insurance = db.get(DriverInsurance, driver_id)
    if not incident or incident.driver_id != driver_id: raise HTTPException(404, 'Incident not found')
    if not insurance or not insurance.policy_number: raise HTTPException(409, 'Record the issued insurance policy first')
    row = db.scalar(select(DriverInsuranceClaim).where(DriverInsuranceClaim.driver_id == driver_id, DriverInsuranceClaim.reference == data.reference))
    if not row: row = DriverInsuranceClaim(driver_id=driver_id, **data.model_dump()); db.add(row)
    else:
        for key, value in data.model_dump().items(): setattr(row, key, value)
    service.audit(db, actor, driver_id, 'insurance-claim-updated', data.reference)
    db.flush()
    return {'id': row.id, 'status': row.status}


