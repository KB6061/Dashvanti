@router.post('/driver/partner/devices')
def device(data: PushDeviceInput, user=Depends(driver), db=Depends(get_db, scope='function')):
    row = db.get(DriverPushDevice, data.installation_id)
    other = db.scalar(select(DriverPushDevice).where(DriverPushDevice.token == data.token))
    if (row and row.driver_id != user.id) or (other and other.installation_id != data.installation_id): raise HTTPException(409, 'Device is registered to another account or installation')
    if not row: row = DriverPushDevice(installation_id=data.installation_id, driver_id=user.id, token=data.token, token_version=user.token_version); db.add(row)
    row.token = data.token; row.token_version = user.token_version
    return {'registered': True}


@router.delete('/driver/partner/devices/{installation_id}')
