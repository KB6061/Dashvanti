@router.get('/admin/driver-partners')
def listing(status: str = '', offset: int = 0, actor=Depends(manager), db=Depends(get_db, scope='function')):
    query = select(DriverPartner)
    if status: query = query.where((DriverPartner.status == status) | (DriverPartner.account_status == status))
    rows = db.scalars(query.order_by(DriverPartner.updated_at.desc()).offset(max(0, offset)).limit(50))
    return {'items': [service.overview(db, r.driver_id, True) for r in rows]}


@router.get('/admin/driver-partners/reports/{kind}')
def reports(kind: str, actor=Depends(manager), db=Depends(get_db, scope='function')):
    models = {'deposits': DriverDeposit, 'incidents': DriverIncident, 'withdrawals': DriverWithdrawal, 'insurance-claims': DriverInsuranceClaim, 'verifications': DriverVerification}
    if kind in models:
        model = models[kind]
        rows = db.scalars(select(model).order_by(model.id.desc()).limit(500))
        return {'items': [{c.name: getattr(r, c.name) for c in model.__table__.columns} for r in rows]}
    if kind == 'suspensions':
        rows = db.scalars(select(AuditEvent).where(AuditEvent.action.in_(['driver-partner:SUSPEND', 'driver-partner:DEACTIVATE', 'driver-partner:WARNING'])).order_by(AuditEvent.id.desc()).limit(500))
        return {'items': [{'driver_id': r.target, 'action': r.action, 'notes': r.details, 'created_at': r.created_at} for r in rows]}
    if kind in {'active', 'online'}:
        query = select(DriverPartner.driver_id).where(DriverPartner.account_status == 'ACTIVE')
        if kind == 'online': query = query.join(Driver, Driver.id == DriverPartner.driver_id).where(Driver.online.is_(True))
        return {'items': [service.overview(db, i) for i in db.scalars(query.limit(500))]}
    if kind == 'earnings':
        return {'items': [{'driver_id': i, **service.earnings(db, i)} for i in db.scalars(select(DriverPartner.driver_id).limit(500))]}
    if kind == 'daily-deliveries':
        from backend.models import DeliveryStatus, now
        rows = db.execute(select(Order.id, Order.driver_id, DeliveryStatus.created_at).join(DeliveryStatus, DeliveryStatus.order_id == Order.id).where(DeliveryStatus.status == 'DELIVERED', DeliveryStatus.created_at >= now().replace(hour=0, minute=0, second=0)).limit(500))
        return {'items': [{'order_id': r[0], 'driver_id': r[1], 'delivered_at': r[2]} for r in rows]}
    if kind == 'ratings':
        rows = db.execute(select(Rating.order_id, Order.driver_id, Rating.driver).join(Order, Order.id == Rating.order_id).where(Rating.driver.is_not(None)).limit(500))
        return {'items': [{'order_id': r[0], 'driver_id': r[1], 'rating': r[2]} for r in rows]}
    raise HTTPException(404, 'Unknown report')


