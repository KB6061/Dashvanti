@router.post('/driver-partner/manager/login')
def manager_login(data: ManagerLogin, db=Depends(get_db, scope='function')):
    from types import SimpleNamespace
    from backend.services.auth_service import login
    return login(db, SimpleNamespace(email=data.email, password=data.password, role='operations_manager'))


def manager(request: Request, auth=Depends(optional_bearer), db=Depends(get_db, scope='function')):
    if auth:
        user = current_user(request, auth, db)
        if user.role not in {'admin', 'operations_manager'}: raise HTTPException(403, 'Manager access required')
        return user
    admin_secret(request.headers.get('X-Dashvanti-Admin-Secret', ''))
    return None


def admin(actor=Depends(manager)):
    if actor and actor.role != 'admin': raise HTTPException(403, 'Admin access required')
    return actor


