  "components": {
    "schemas": {
      "AddressInput": {
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Label"
          },
          "details": {
            "type": "string",
            "maxLength": 500,
            "minLength": 5,
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "label",
          "details"
        ],
        "title": "AddressInput"
      },
      "Availability": {
        "properties": {
          "online": {
            "type": "boolean",
            "title": "Online"
          }
        },
        "type": "object",
        "required": [
          "online"
        ],
        "title": "Availability"
      },
      "Body_upload_api_files_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "purpose": {
            "type": "string",
            "title": "Purpose"
          },
          "entity_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entity Id"
          }
        },
        "type": "object",
        "required": [
          "file",
          "purpose"
        ],
        "title": "Body_upload_api_files_post"
      },
      "CartInput": {
        "properties": {
          "menu_item_id": {
            "type": "integer",
            "title": "Menu Item Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "menu_item_id",
          "quantity"
        ],
        "title": "CartInput"
      },
      "Checkout": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "delivery",
              "pickup"
            ],
            "title": "Mode"
          },
          "address_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address Id"
          },
          "request_key": {
            "type": "string",
            "maxLength": 64,
            "minLength": 16,
            "title": "Request Key"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "request_key"
        ],
        "title": "Checkout"
      },
      "Forgot": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "Forgot"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "title": "Password"
          },
          "role": {
            "type": "string",
            "enum": [
              "customer",
              "restaurant",
              "driver"
            ],
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password",
          "role"
        ],
        "title": "Login"
      },
      "MenuInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "title": "Description",
            "default": ""
          },
          "price": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$"
              }
            ],
            "title": "Price"
          },
          "veg": {
            "type": "boolean",
            "title": "Veg",
            "default": true
          },
          "available": {
            "type": "boolean",
            "title": "Available",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "name",
          "price"
        ],
        "title": "MenuInput"
      },
      "Profile": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "phone": {
            "type": "string",
            "maxLength": 30,
            "title": "Phone",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Profile"
      },
      "Register": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "role": {
            "type": "string",
            "enum": [
              "customer",
              "restaurant",
              "driver"
            ],
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password",
          "name",
          "role"
        ],
        "title": "Register"
      },
      "Reset": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 200,
            "title": "Token"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "title": "Reset"
      },
      "RestaurantInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "cuisine": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Cuisine"
          },
          "kind": {
            "type": "string",
            "enum": [
              "restaurant",
              "store"
            ],
            "title": "Kind",
            "default": "restaurant"
          },
          "address": {
            "type": "string",
            "maxLength": 500,
            "minLength": 5,
            "title": "Address"
          },
          "is_open": {
            "type": "boolean",
            "title": "Is Open",
            "default": false
          },
          "opening": {
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
            "title": "Opening"
          },
          "closing": {
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
            "title": "Closing"
          },
          "delivery_minutes": {
            "type": "integer",
            "maximum": 240.0,
            "minimum": 5.0,
            "title": "Delivery Minutes"
          }
        },
        "type": "object",
        "required": [
          "name",
          "cuisine",
          "address",
          "opening",
          "closing",
          "delivery_minutes"
        ],
        "title": "RestaurantInput"
      },
      "ReviewInput": {
        "properties": {
          "restaurant": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Restaurant"
          },
          "driver": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Driver"
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "restaurant",
          "text"
        ],
        "title": "ReviewInput"
      },
      "Transition": {
        "properties": {
          "status": {
            "type": "string",
            "maxLength": 40,
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Transition"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
