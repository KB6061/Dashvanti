[Unit]
Description=Dashvanti %i
Wants=network-online.target
After=network-online.target postgresql.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=krishna
Group=krishna
WorkingDirectory=/home/krishna/food
ExecStart=/bin/bash /home/krishna/food/deploy/systemd/run-service.sh %i
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true
SyslogIdentifier=dashvanti-%i

[Install]
WantedBy=multi-user.target
